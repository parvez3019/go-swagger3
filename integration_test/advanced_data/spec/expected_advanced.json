  "paths": {
    "/admin/stats": {
      "get": {
        "responses": {
          "200": {
            "description": "Stats",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stats"
                }
              }
            }
          }
        },
        "tags": [
          "admin"
        ],
        "summary": "Stats",
        "operationId": "GetStats",
        "parameters": [
          {
            "name": "at",
            "in": "query",
            "description": "Point in time",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "security": [
          {
            "OIDC": []
          },
          {
            "CookieAuth": []
          }
        ]
      }
    },
    "/items": {
      "get": {
        "responses": {
          "200": {
            "description": "Matching items",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          },
          "206": {
            "description": "Partial page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Items"
                }
              }
            }
          },
          "400": {
            "description": "Bad query",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "tags": [
          "items"
        ],
        "summary": "Search items",
        "description": " Search the catalogue.",
        "operationId": "SearchItems",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Search text",
            "example": "widget",
            "schema": {
              "type": "string",
              "description": "Search text",
              "example": "widget"
            }
          },
          {
            "name": "since",
            "in": "query",
            "description": "Only items updated since",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size",
            "schema": {
              "type": "integer",
              "format": "int64",
              "description": "Page size",
              "default": 20,
              "maximum": 100,
              "minimum": 1
            }
          },
          {
            "name": "active",
            "in": "query",
            "description": "Only active items",
            "schema": {
              "type": "boolean",
              "description": "Only active items",
              "default": true
            }
          },
          {
            "name": "X-Trace-Id",
            "in": "header",
            "description": "Trace identifier",
            "schema": {
              "type": "string",
              "description": "Trace identifier"
            }
          },
          {
            "name": "session",
            "in": "cookie",
            "description": "Session cookie",
            "schema": {
              "type": "string",
              "description": "Session cookie"
            }
          }
        ]
      },
      "post": {
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          }
        },
        "tags": [
          "items"
        ],
        "summary": "Create items",
        "operationId": "CreateItems",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "BasicAuth": []
          }
        ]
      }
    },
    "/items/index": {
      "get": {
        "responses": {
          "200": {
            "description": "Items by ID",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/components/schemas/Item"
                  }
                }
              }
            }
          },
          "202": {
            "description": "Named index",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemIndex"
                }
              }
            }
          },
          "204": {
            "description": "Untyped payload",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "tags": [
          "items"
        ],
        "summary": "Item index",
        "operationId": "GetItemIndex"
      }
    },
    "/items/{id}/image": {
      "post": {
        "responses": {
          "204": {
            "description": "Uploaded",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "tags": [
          "items"
        ],
        "summary": "Upload image",
        "operationId": "UploadImage",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Item ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "description": "Item ID"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "caption": {
                    "type": "string",
                    "description": "Caption"
                  },
                  "image": {
                    "type": "string",
                    "format": "binary",
                    "description": "Image file"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/items/{id}/labels": {
      "put": {
        "responses": {
          "200": {
            "description": "Updated labels",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Labels"
                }
              }
            }
          }
        },
        "tags": [
          "items"
        ],
        "summary": "Set labels",
        "operationId": "SetLabels",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Item ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "description": "Item ID"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          },
          "required": true
        }
      }
    },
    "/items/{id}/name": {
      "put": {
        "responses": {
          "200": {
            "description": "Renamed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          }
        },
        "tags": [
          "items"
        ],
        "summary": "Rename item",
        "operationId": "RenameItem",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Item ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "description": "Item ID"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        }
      }
    },
    "/wrapper": {
      "get": {
        "responses": {
          "200": {
            "description": "Wrapper",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Wrapper"
                }
              }
            }
          },
          "201": {
            "description": "Pair",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pair_string_Item"
                }
              }
            }
          },
          "202": {
            "description": "Box",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Box_Owner"
                }
              }
            }
          }
        },
        "tags": [
          "items"
        ],
        "summary": "Get wrapper",
        "operationId": "GetWrapper"
      }
    }
  },
